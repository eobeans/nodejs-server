{
  "name": "system-service",
  "version": "1.0.0",
  "description": "系统管理服务器",
  "main": "start.ts",
  "scripts": {
    "dev": "nodemon start.ts",
    "db:diff": "npx prisma migrate diff --from-empty --to-schema-datamodel data-access/prisma/schema.prisma --script > data-access/prisma/migrations/20240723094000_baseline/migration.sql",
    "db:apply": "npx prisma migrate resolve --applied 20240723094000_baseline --schema data-access/prisma/schema.prisma",
    "db:deploy": "npx prisma migrate deploy --schema data-access/prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema data-access/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/md5": "^2.3.5",
    "@types/node": "^22.5.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@practica/error-handling": "^0.0.3",
    "@practica/logger": "^0.0.3",
    "@prisma/client": "4.16.2",
    "@sinclair/typebox": "^0.32.34",
    "ajv": "^8.17.1",
    "axios": "^1.7.2",
    "convict": "^6.2.4",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
    "mysql": "^2.18.1"
  }
}
